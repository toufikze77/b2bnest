# Public browser settings only. Never put secrets in this file: everything prefixed VITE_ is bundled into the
# public JavaScript that every visitor downloads. The same values are committed in .env.production (production builds)
# and .env.development (npm run dev and Lovable's preview). To use another project locally, copy this file to
# .env.development.local (not committed). Vercel dashboard values, if set, override them.

# Supabase project URL (Supabase → Project Settings → API). Required.
VITE_SUPABASE_URL=https://gvftvswyrevummbvyhxa.supabase.co
# Supabase publishable key (public, safe in the browser; data is protected by row-level security). Required.
# VITE_SUPABASE_ANON_KEY is accepted as an older name for the same public key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YEwhny7sIWP8748Ix69E3w_RUuUkFAy
