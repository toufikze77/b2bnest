# Copy to .env for local development (.env is git-ignored and not committed).
# Browser-safe values only. Never put a service-role key or any secret here:
# everything prefixed VITE_ is bundled into the public JavaScript.
# On Vercel, set the same variables in Project → Settings → Environment Variables.

# Supabase project URL (Supabase → Project Settings → API). Required.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
# Public anon / publishable key (same page). Required. VITE_SUPABASE_ANON_KEY is accepted as an alias.
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
# Project ref (the <project-ref> above). Optional: not read by the app; kept for tooling and reference.
VITE_SUPABASE_PROJECT_ID="<project-ref>"
